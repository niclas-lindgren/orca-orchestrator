{
  "name": "orca-orchestrator",
  "version": "0.4.1",
  "description": "Native Orca issue-delivery skills with repository guards for leases, authority, review, repair, exact-head verification, and cleanup.",
  "type": "module",
  "keywords": [
    "pi-package",
    "orca",
    "agent-orchestration"
  ],
  "pi": {
    "extensions": [
      "./extensions/orca.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    "./authority": {
      "types": "./src/auto/authority.d.ts",
      "default": "./src/auto/authority.mjs"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    }
  },
  "bin": {
    "orca-orchestrator": "bin/orca-orchestrator.mjs"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "bin",
    "extensions",
    "src",
    "skills",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "check": "node --check bin/orca-orchestrator.mjs && node --check bin/orca-orchestrator-mcp.mjs && vitest run"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "vitest": "^3.2.0"
  }
}
