{
  "name": "orca-orchestrator",
  "version": "0.2.1",
  "description": "Issue-delivery tooling and skills for Orca-managed repositories: leases, worktrees, dispatch, independent head verification and ChatGPT review, configured per repository.",
  "type": "module",
  "keywords": [
    "pi-package",
    "orca",
    "agent-orchestration"
  ],
  "pi": {
    "extensions": [
      "./extensions/orca.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "exports": {
    "./authority": {
      "types": "./src/auto/authority.d.ts",
      "default": "./src/auto/authority.mjs"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.mjs"
    }
  },
  "bin": {
    "orca-orchestrator": "bin/orca-orchestrator.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "src",
    "skills",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "vitest run",
    "check": "node --check bin/orca-orchestrator.mjs && vitest run"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "vitest": "^3.2.0"
  }
}
